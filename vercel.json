{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/meta/refresh",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/social-tokens",
      "schedule": "0 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/idealista/feed",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}